# ==============================================================================
# LUKU ROBOT ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and insert your personal API keys.
# DO NOT commit your real .env file with secrets to Git.

# Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
ROBOT_GEMINI_MODEL=gemini-flash-lite-latest

# AI Backend ('gemini' or 'ollama')
ROBOT_AI_BACKEND=gemini

# Ollama Local LLM Configuration (if running local AI)
ROBOT_OLLAMA_URL=http://127.0.0.1:11434
ROBOT_OLLAMA_MODEL=qwen2.5:0.5b

# Speech-to-Text Model
ROBOT_STT_ENGINE=vosk
ROBOT_VOSK_MODEL=vosk-model-small-en-us-0.15

# Text-to-Speech / Audio Output
ROBOT_TTS_ENABLED=false
ROBOT_AUTO_CONNECT_BT=false
