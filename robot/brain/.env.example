# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# AI Backend ('gemini' or 'ollama')
ROBOT_AI_BACKEND=gemini

# Gemini Model ('gemini-2.5-flash', 'gemini-1.5-flash', etc.)
ROBOT_GEMINI_MODEL=gemini-2.5-flash

# Vosk Speech Recognition Model Path
ROBOT_VOSK_MODEL=vosk-model-en-us-0.22-lgraph
